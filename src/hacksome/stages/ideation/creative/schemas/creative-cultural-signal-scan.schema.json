{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "nullableRfc3339Timestamp": {
      "description": "A nullable C1W source timestamp with seconds and an explicit Z or numeric UTC offset. Field-specific publication, observation, and day-anchor semantics are defined by the stage prompt and semantic validator.",
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  },
  "required": ["coverage", "signals", "no_signal_reason"],
  "properties": {
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_families",
        "platforms_attempted",
        "limitations"
      ],
      "properties": {
        "query_families": {
          "type": "array",
          "maxItems": 16,
          "items": {"type": "string", "minLength": 1}
        },
        "platforms_attempted": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "kind"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "kind": {
                "enum": [
                  "social",
                  "video",
                  "forum",
                  "news",
                  "blog",
                  "project",
                  "search_trend",
                  "other"
                ]
              }
            }
          }
        },
        "limitations": {
          "type": "array",
          "maxItems": 12,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "signals": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "creative_role",
          "label",
          "neutral_summary",
          "abstract_pattern",
          "creative_tension",
          "participation_shape",
          "surface_markers_to_avoid",
          "safety_flags",
          "confidence",
          "sources"
        ],
        "properties": {
          "kind": {
            "enum": ["trend", "meme", "controversy", "counter_signal"]
          },
          "creative_role": {
            "enum": ["inspire", "avoid", "context_only"]
          },
          "label": {"type": "string", "minLength": 1},
          "neutral_summary": {"type": "string", "minLength": 1},
          "abstract_pattern": {"type": "string", "minLength": 1},
          "creative_tension": {"type": "string", "minLength": 1},
          "participation_shape": {"type": "string", "minLength": 1},
          "surface_markers_to_avoid": {
            "type": "array",
            "maxItems": 8,
            "items": {"type": "string", "minLength": 1}
          },
          "safety_flags": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "none",
                "harassment",
                "privacy",
                "misinformation",
                "political",
                "graphic",
                "minors"
              ]
            }
          },
          "confidence": {"enum": ["low", "medium", "high"]},
          "sources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "title",
                "url",
                "publisher",
                "source_kind",
                "platform",
                "published_at",
                "observed_at",
                "time_precision",
                "locale",
                "evidence_summary"
              ],
              "properties": {
                "title": {"type": "string", "minLength": 1},
                "url": {"type": "string", "minLength": 1},
                "publisher": {"type": "string", "minLength": 1},
                "source_kind": {
                  "enum": [
                    "primary_post",
                    "platform_trend_page",
                    "first_party_statement",
                    "news_report",
                    "analysis"
                  ]
                },
                "platform": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "kind"],
                  "properties": {
                    "name": {"type": "string", "minLength": 1},
                    "kind": {
                      "enum": [
                        "social",
                        "video",
                        "forum",
                        "news",
                        "blog",
                        "project",
                        "search_trend",
                        "other"
                      ]
                    }
                  }
                },
                "published_at": {
                  "$ref": "#/$defs/nullableRfc3339Timestamp"
                },
                "observed_at": {
                  "$ref": "#/$defs/nullableRfc3339Timestamp"
                },
                "time_precision": {
                  "enum": ["minute", "day", "month", "unknown"]
                },
                "locale": {"type": "string", "minLength": 1},
                "evidence_summary": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "no_signal_reason": {"type": ["string", "null"], "minLength": 1}
  }
}
